// Okie ACO data model.
//
// Conventions, all load-bearing:
//   - Discord snowflake IDs are String, never Int/BigInt. 1478471872726302922 already
//     exceeds 2^53 and a numeric type would silently corrupt it.
//   - Money is Int cents everywhere, matching the bot. Never a float, never Decimal.
//   - Domain rows key off DiscordMember.discordUserId, NOT User.id, because a member has
//     checkouts and bills long before they ever sign in to the website.
//   - Anything already sent to a member is immutable. Corrections append.
//   - snake_case in the database, camelCase in the client. Every column carries @map so
//     raw SQL and psql sessions never need double-quoted identifiers.
//
// Prisma 7: no `url` here (it lives in prisma.config.ts) and the generator emits
// TypeScript into src/generated/prisma, which is gitignored and rebuilt by `prisma generate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------
// Created on first sign-in. Deliberately NOT the canonical member record --
// DiscordMember is. `email` stays null because we never request the email scope.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?

  // The link to everything else. Set from the Discord OAuth profile on first sign-in.
  discordUserId String? @unique @map("discord_user_id")

  hideFromPublicFeed Boolean   @default(false) @map("hide_from_public_feed")
  firstLoginAt       DateTime  @default(now()) @map("first_login_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]
  member   DiscordMember? @relation(fields: [discordUserId], references: [discordUserId])

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  // Nulled out after sign-in -- we never call Discord as the user, so there is no
  // reason to hold a live credential.
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Database sessions rather than JWT: deleting a row is instant revocation, which
// matters on a site where an admin controls what people are billed.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Discord membership
// ---------------------------------------------------------------------------
// Synced by the bot on ready and on member add/remove/update, so the site makes zero
// Discord API calls at request time. This is the canonical member record.

model DiscordMember {
  discordUserId String    @id @map("discord_user_id")
  username      String
  globalName    String?   @map("global_name")
  avatarHash    String?   @map("avatar_hash")
  roles         String[]  @default([])
  isOg          Boolean   @default(false) @map("is_og")
  joinedAt      DateTime? @map("joined_at") @db.Timestamptz(3)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)

  user             User?
  profiles         Profile[]
  pasBills         PasBill[]
  vaultAccounts    VaultAccount[]
  vaultProfiles    VaultProfile[]
  emailCredentials EmailCredential[]
  emailAliases     EmailAlias[]

  @@index([leftAt])
  @@map("discord_members")
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
// Checkouts are recorded against a checkout-profile name, not a Discord ID. This is
// the mapping. profileKey is normalized: lowercased with a trailing " - N" stripped,
// so "carter" and "carter - 3" are one row.

enum ProfileStatus {
  MAPPED
  UNMAPPED
  IGNORED

  @@map("profile_status")
}

model Profile {
  profileKey    String        @id @map("profile_key")
  displayName   String        @map("display_name")
  discordUserId String?       @map("discord_user_id")
  status        ProfileStatus @default(UNMAPPED)
  // Owned but not billed: the operator's own house profiles. Their checkouts still
  // belong to a person and still appear on the site -- they just never generate a fee.
  billable      Boolean       @default(true)
  note          String?
  mappedBy      String?       @map("mapped_by")
  mappedAt      DateTime?     @map("mapped_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  member    DiscordMember? @relation(fields: [discordUserId], references: [discordUserId])
  checkouts Checkout[]

  @@index([discordUserId])
  @@index([status])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Items and fees
// ---------------------------------------------------------------------------

model Item {
  id String @id @default(uuid())

  // Normalized product name. Must match the bot's normalizeProduct() byte for byte.
  productKey String  @unique @map("product_key")
  label      String
  source     String?
  // Null until a SKU is actually extractable from the vendor embeds. The composite
  // unique below only binds once both source and sku are non-null -- Postgres treats
  // NULLs as distinct -- so this upgrades cleanly without blocking on data we lack.
  sku        String?

  // The "edit fees on the fly" column. This is only the DEFAULT that pre-fills the
  // bot's fee modal; what a member was actually charged lives on PasBillLine.
  currentFeeCents Int? @map("current_fee_cents")

  // Product thumbnail. Stored as Discord's proxy URL rather than the retailer's own:
  // one remotePatterns entry then covers every retailer, present and future.
  imageUrl String? @map("image_url")

  // True for bare numeric SKUs that would read as a meaningless number on a bill.
  unreadable Boolean @default(false)
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  aliases   ItemAlias[]
  checkouts Checkout[]
  billLines PasBillLine[]

  @@unique([source, sku])
  @@index([active])
  @@map("items")
}

// Maps raw product strings onto a canonical item. Replaces productAliases.json and
// is how the same product arriving from two vendors under different names gets merged.
model ItemAlias {
  aliasKey  String   @id @map("alias_key")
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_aliases")
}

// ---------------------------------------------------------------------------
// Checkouts
// ---------------------------------------------------------------------------

model Checkout {
  id String @id @default(uuid())

  // Idempotency. Both are nullable-safe: Postgres treats NULLs as distinct, so
  // backfilled rows without an order ID don't collide with each other.
  orderId          String? @map("order_id")
  sourceBot        String  @map("source_bot")
  discordMessageId String  @unique @map("discord_message_id")
  discordChannelId String  @map("discord_channel_id")

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  site       String?

  productRaw String? @map("product_raw")
  productKey String  @map("product_key")
  itemId     String? @map("item_id")

  profileRaw   String? @map("profile_raw")
  profileKey   String? @map("profile_key")
  profileIndex Int?    @map("profile_index")

  // As observed on this checkout, so Item.imageUrl can be re-derived if a retailer
  // swaps artwork or a URL rots.
  imageUrl String? @map("image_url")

  quantity        Int     @default(1)
  quantityAssumed Boolean @default(false) @map("quantity_assumed")

  // Parser observations worth surfacing to the operator, e.g. quantity-assumed,
  // unreadable-product, no-profile, clock-skew.
  flags String[] @default([])

  // The complete vendor embed as it arrived. This is what makes order-ID and SKU
  // extraction recoverable later without re-scraping Discord.
  rawEmbed Json? @map("raw_embed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item    Item?    @relation(fields: [itemId], references: [id])
  profile Profile? @relation(fields: [profileKey], references: [profileKey])

  @@unique([sourceBot, orderId])
  @@index([occurredAt(sort: Desc)])
  @@index([profileKey])
  @@index([itemId])
  @@map("checkouts")
}

// ---------------------------------------------------------------------------
// PAS billing
// ---------------------------------------------------------------------------

enum PasRunStatus {
  DRAFT
  PREVIEW
  SENDING
  SENT
  ABORTED
  CANCELLED

  @@map("pas_run_status")
}

enum DeliveryStatus {
  PENDING
  SENT
  SKIPPED
  DMS_CLOSED
  UNKNOWN_USER
  ERROR

  @@map("delivery_status")
}

model PasRun {
  id String @id @default(uuid())

  // The bot's own session id, e.g. "msjtwyva-b9e6".
  sessionId   String       @unique @map("session_id")
  windowStart DateTime     @map("window_start") @db.Timestamptz(3)
  windowEnd   DateTime     @map("window_end") @db.Timestamptz(3)
  dropLabel   String       @map("drop_label")
  status      PasRunStatus @default(DRAFT)
  dryRun      Boolean      @default(true) @map("dry_run")
  operatorId  String       @map("operator_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt      DateTime?    @map("sent_at") @db.Timestamptz(3)

  bills PasBill[]

  @@index([windowStart(sort: Desc)])
  @@map("pas_runs")
}

// One bill per member per run. Immutable once sent -- corrections append a Payment
// or a new run, they never rewrite these numbers.
model PasBill {
  id            String @id @default(uuid())
  pasRunId      String @map("pas_run_id")
  discordUserId String @map("discord_user_id")

  subtotalCents Int @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  totalCents    Int @map("total_cents")

  // Snapshot of OG status at billing time. A later role change must not alter a
  // bill that has already been sent.
  ogApplied Boolean @default(false) @map("og_applied")

  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryError  String?        @map("delivery_error")
  dmMessageId    String?        @map("dm_message_id")
  // The exact text the member received. Makes the member's charge page authoritative
  // rather than a reconstruction, which is what settles a dispute months later.
  dmText         String?        @map("dm_text")

  // Set only by the operator, and only once money has actually arrived.
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(3)
  markedPaidBy String?   @map("marked_paid_by")

  // The member's claim that they have sent payment. Deliberately a separate fact from
  // paidAt: a claim is a message, a confirmation is a receipt, and only the operator can
  // see money land. A member can clear their own claim -- that is a mis-click being
  // corrected, not a payment being reversed.
  paidClaimedAt     DateTime? @map("paid_claimed_at") @db.Timestamptz(3)
  paidClaimedMethod String?   @map("paid_claimed_method")
  paidClaimedNote   String?   @map("paid_claimed_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run      PasRun        @relation(fields: [pasRunId], references: [id], onDelete: Cascade)
  member   DiscordMember @relation(fields: [discordUserId], references: [discordUserId])
  lines    PasBillLine[]
  payments Payment[]

  @@unique([pasRunId, discordUserId])
  @@index([discordUserId, paidAt])
  // Drives the admin queue: unconfirmed claims, oldest first.
  @@index([paidAt, paidClaimedAt])
  @@map("pas_bills")
}

// Snapshot of what was charged. feeCents is deliberately NOT a join to
// Item.currentFeeCents -- editing a fee must never rewrite an existing bill.
model PasBillLine {
  id            String @id @default(uuid())
  pasBillId     String @map("pas_bill_id")
  itemId        String @map("item_id")
  qty           Int
  feeCents      Int    @map("fee_cents")
  subtotalCents Int    @map("subtotal_cents")
  // Denormalized so the bill still renders correctly if an item is later renamed.
  label         String

  bill PasBill @relation(fields: [pasBillId], references: [id], onDelete: Cascade)
  item Item    @relation(fields: [itemId], references: [id])

  @@index([pasBillId])
  @@index([itemId])
  @@map("pas_bill_lines")
}

// The receipt. Marking a bill paid writes one of these and stamps PasBill.paidAt;
// the bill's amounts are never touched.
model Payment {
  id          String   @id @default(uuid())
  pasBillId   String   @map("pas_bill_id")
  amountCents Int      @map("amount_cents")
  method      String?
  note        String?
  recordedBy  String   @map("recorded_by")
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  bill PasBill @relation(fields: [pasBillId], references: [id], onDelete: Cascade)

  @@index([pasBillId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Site content and audit
// ---------------------------------------------------------------------------

enum TestimonialSource {
  MANUAL
  DISCORD

  @@map("testimonial_source")
}

model Testimonial {
  id              String            @id @default(uuid())
  body            String
  attribution     String?
  source          TestimonialSource @default(MANUAL)
  // Set when pulled through from a Discord vouches channel.
  sourceMessageId String?           @map("source_message_id")
  approved        Boolean           @default(false)
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([approved, sortOrder])
  @@map("testimonials")
}

// Append-only. Every admin mutation lands here; nothing ever updates or deletes.
model AdminAudit {
  id             String   @id @default(uuid())
  actorDiscordId String   @map("actor_discord_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  at             DateTime @default(now()) @db.Timestamptz(3)

  @@index([at(sort: Desc)])
  @@index([entity, entityId])
  @@map("admin_audit")
}

// ---------------------------------------------------------------------------
// Profile vault
// ---------------------------------------------------------------------------
// Retailer accounts and checkout profiles, owned and edited by members.
//
// SECRETS ARE WRITE-ONLY. Card number, CVV, and passwords live in `*_enc` columns as
// AES-256-GCM envelopes (src/lib/vault/crypto.ts) and are never rendered in any UI --
// not the member's, not the admin's. They leave the system only through an audited
// export. Everything needed for display (brand, last 4, expiry) is stored in clear so
// a page render never has to decrypt.
//
// Shapes below were verified against all 269 real profiles rather than assumed:
//   - nameOnCard always equalled the shipping name  -> derived on export, no column
//   - billing and shipping email were always equal  -> one email, held on the account
//   - sameBillingAndShipping DISAGREED with the addresses on 4 profiles, so the flag
//     is stored rather than computed
//   - 18 CVVs and every expiry month/year need leading zeros -> all TEXT, never Int

model VaultAccount {
  id      String @id @default(uuid())
  siteKey String @map("site_key")

  // The retailer login. Also the profile's email: the 1:1 rule members asked for is
  // enforced structurally by this unique plus VaultProfile.accountId being unique,
  // rather than by a check that could drift.
  email       String
  passwordEnc String @map("password_enc")

  discordUserId String  @map("discord_user_id")
  active        Boolean @default(true)
  note          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member  DiscordMember @relation(fields: [discordUserId], references: [discordUserId])
  profile VaultProfile?

  // An account may exist with no profile yet -- 11 do in the current export.
  @@unique([siteKey, email])
  @@index([discordUserId, siteKey])
  @@map("vault_accounts")
}

model VaultProfile {
  id      String @id @default(uuid())
  siteKey String @map("site_key")

  discordUserId String @map("discord_user_id")

  // Canonical name, in the Shikari form ("shockereyes - 6"). NOT the AYCD form: 49 of
  // the 68 MacBook AYCD names carry suffixes like "-!50" that nothing else uses.
  name String

  // Normalized base ("shockereyes") and index (6), matching the bot's normalizeProfile.
  // Deliberately a plain column, not a foreign key: a vault profile can exist long
  // before that profile has ever appeared in a checkout.
  profileKey   String @map("profile_key")
  profileIndex Int?   @map("profile_index")

  // Per-site enable/disable, so a member can park a profile without deleting it.
  active Boolean @default(true)

  accountId String @unique @map("account_id")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  shipLine1      String  @map("ship_line1")
  shipLine2      String? @map("ship_line2")
  shipCity       String  @map("ship_city")
  shipState      String  @map("ship_state")
  shipPostalCode String  @map("ship_postal_code")
  shipCountry    String  @default("US") @map("ship_country")

  // False on 46 of 201 real profiles, and wrong-looking on 4 more -- always stored.
  sameBillingAndShipping Boolean @default(true) @map("same_billing_and_shipping")

  billFirstName  String? @map("bill_first_name")
  billLastName   String? @map("bill_last_name")
  billLine1      String? @map("bill_line1")
  billLine2      String? @map("bill_line2")
  billCity       String? @map("bill_city")
  billState      String? @map("bill_state")
  billPostalCode String? @map("bill_postal_code")
  billCountry    String? @map("bill_country")

  // Clear: enough to render "Visa ···· 3384, exp 11/30" without decrypting anything.
  cardBrand    String @map("card_brand")
  cardLast4    String @map("card_last4")
  cardExpMonth String @map("card_exp_month")
  cardExpYear  String @map("card_exp_year")

  // Write-only. See the section header.
  cardNumberEnc String @map("card_number_enc")
  cardCvvEnc    String @map("card_cvv_enc")

  onlyCheckoutOnce          Boolean @default(false) @map("only_checkout_once")
  matchNameOnCardAndAddress Boolean @default(true) @map("match_name_on_card_and_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by")

  account VaultAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member  DiscordMember @relation(fields: [discordUserId], references: [discordUserId])

  @@unique([siteKey, name])
  @@index([discordUserId, siteKey])
  @@index([profileKey])
  @@index([siteKey, active])
  @@map("vault_profiles")
}

// App passwords for IMAP, so 2FA codes can be read without asking the member.
model EmailCredential {
  id            String @id @default(uuid())
  discordUserId String @map("discord_user_id")

  // Globally unique: an inbox belongs to exactly one person.
  email          String @unique
  appPasswordEnc String @map("app_password_enc")

  // Derived from the domain on save; overridable for self-hosted mail.
  imapHost String? @map("imap_host")
  imapPort Int?    @map("imap_port")

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  lastError  String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member  DiscordMember @relation(fields: [discordUserId], references: [discordUserId])
  aliases EmailAlias[]

  @@index([discordUserId])
  @@map("email_credentials")
}

// An address that needs no app password of its own because its mail lands in one that
// has one. Ten retailer accounts forwarding into a single Gmail means one app password,
// not ten -- the bot reads the verification code from wherever it actually arrives.
//
// Deliberately points at a CREDENTIAL, not at another address: an alias chain would need
// cycle detection and could strand a mailbox behind a link that no longer has a password.
// One hop, always terminating at a real mailbox.
model EmailAlias {
  id            String @id @default(uuid())
  discordUserId String @map("discord_user_id")

  // The retailer-facing address. Unique across the table AND checked against
  // email_credentials.email on write: an address either holds a password or forwards,
  // never both.
  email        String @unique
  credentialId String @map("credential_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member     DiscordMember   @relation(fields: [discordUserId], references: [discordUserId])
  // Removing the destination mailbox removes the claim that mail lands there. Leaving
  // the alias pointing at nothing would read as "covered" when it no longer is.
  credential EmailCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([discordUserId])
  @@index([credentialId])
  @@map("email_aliases")
}

enum VaultEntity {
  VAULT_PROFILE
  VAULT_ACCOUNT
  EMAIL_CREDENTIAL
  EMAIL_ALIAS

  @@map("vault_entity")
}

enum VaultAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE

  @@map("vault_action")
}

// Append-only. Records WHICH FIELDS changed and never their values -- an audit log
// holding card numbers would defeat the encryption it exists to police.
model VaultChange {
  id             String      @id @default(uuid())
  actorDiscordId String      @map("actor_discord_id")
  ownerDiscordId String      @map("owner_discord_id")
  entity         VaultEntity
  entityId       String      @map("entity_id")
  action         VaultAction
  siteKey        String?     @map("site_key")
  label          String?
  fields         String[]    @default([])

  at         DateTime  @default(now()) @db.Timestamptz(3)
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(3)

  @@index([at(sort: Desc)])
  @@index([ownerDiscordId])
  @@index([notifiedAt])
  @@map("vault_changes")
}

// Every export, because an export is the one operation that puts plaintext secrets on
// disk. If credentials ever turn up somewhere they shouldn't, this is the trail.
model VaultExport {
  id              String  @id @default(uuid())
  actorDiscordId  String  @map("actor_discord_id")
  siteKey         String  @map("site_key")
  format          String
  scope           String
  targetDiscordId String? @map("target_discord_id")
  profileCount    Int     @map("profile_count")
  accountCount    Int     @map("account_count")

  at DateTime @default(now()) @db.Timestamptz(3)

  @@index([at(sort: Desc)])
  @@map("vault_exports")
}

// Every time a stored secret was put on someone's screen. Same reason VaultExport
// exists: the only difference between a reveal and an export is that a reveal doesn't
// touch disk -- a human still read the plaintext. Records WHICH field, never the value.
model VaultReveal {
  id             String      @id @default(uuid())
  actorDiscordId String      @map("actor_discord_id")
  ownerDiscordId String      @map("owner_discord_id")
  entity         VaultEntity
  entityId       String      @map("entity_id")
  field          String
  // True when the actor revealed someone else's secret, which is the case worth finding
  // in this table later. Self-reveals are noise by comparison.
  onBehalf       Boolean     @default(false) @map("on_behalf")

  at DateTime @default(now()) @db.Timestamptz(3)

  @@index([at(sort: Desc)])
  @@index([ownerDiscordId])
  @@map("vault_reveals")
}

// Lets the one-time history backfill resume after a crash instead of restarting.
model BackfillProgress {
  channelId         String    @id @map("channel_id")
  sourceBot         String    @map("source_bot")
  lastMessageId     String?   @map("last_message_id")
  messagesSeen      Int       @default(0) @map("messages_seen")
  checkoutsIngested Int       @default(0) @map("checkouts_ingested")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
