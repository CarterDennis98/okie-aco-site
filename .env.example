# Copy to .env.local for development. Never commit real values.

# --- Database -------------------------------------------------------------
# Local dev runs against a native PostgreSQL 17 install. Also what the Prisma CLI
# reads (from .env, NOT .env.local -- the CLI does not use Next's convention).
#
# One-time setup, run in pgAdmin's Query Tool while connected to the okie-aco database:
#   CREATE ROLE okie LOGIN CREATEDB PASSWORD 'okie';
#   ALTER DATABASE "okie-aco" OWNER TO okie;
#   GRANT ALL ON SCHEMA public TO okie;
#   ALTER SCHEMA public OWNER TO okie;
# CREATEDB is required for prisma migrate dev's shadow database; the schema grants are
# required because PG 15+ dropped the implicit CREATE on public.
DATABASE_URL="postgresql://okie:okie@127.0.0.1:5432/okie-aco"

# Fallback: `npm run db:up` starts a throwaway Postgres in Docker on 5433 (5432 is
# taken by the native install). Only needed if you want a guaranteed-clean instance.
# DATABASE_URL="postgresql://okie:okie@127.0.0.1:5433/okie"

# Pool size PER CONTAINER INSTANCE. Multiply by Cloud Run max-instances and keep the
# product under Cloud SQL's max_connections (~25 on db-f1-micro).
# Note: `?connection_limit=` on the URL is a silent no-op in Prisma 7 -- pool config
# moved to the driver adapter, which reads this.
DB_POOL_MAX="3"

# On Cloud Run, set these instead of DATABASE_URL and the client connects over the
# Cloud SQL connector's Unix socket.
# CLOUD_SQL_CONNECTION_NAME="PROJECT:us-central1:okie-pg"
# DB_USER="okie_app"
# DB_PASSWORD=""
# DB_NAME="okie"

# --- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# From https://discord.com/developers/applications -> your app -> OAuth2.
# AUTH_DISCORD_ID is the Application ID; AUTH_DISCORD_SECRET is the OAuth2 client
# secret (NOT the bot token). Add both redirect URIs to the same application:
#   http://localhost:3000/api/auth/callback/discord
#   https://okie-aco.com/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Required behind Cloud Run's TLS-terminating proxy, harmless locally.
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# --- Next.js ---------------------------------------------------------------
# MUST be set and stable across Cloud Run instances. Defaults to a per-build
# random key, so with >1 instance an action encrypted by one cannot be decrypted
# by another and mutations fail with "Failed to find Server Action".
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Discord ---------------------------------------------------------------
DISCORD_GUILD_ID="1478471872726302922"
DISCORD_INVITE_URL=""
# Role that gets 50% off. Read at sign-in from the guild member object, so OG status is
# correct from the first login without waiting on the bot's role sync. Must match
# ROLE_OG_MEMBER in the bot's src/config.js. If left empty, isOg is never written --
# deliberately, so a missing value can't silently demote every OG member.
DISCORD_OG_ROLE_ID="1479215474926555178"
# Where "Payment methods" on the dashboard points. The bot's PAYMENT_LINK.
DISCORD_PAYMENT_URL=""
# Comma-separated. Authority lives here, never in the database.
ADMIN_DISCORD_IDS=""

# --- Profile vault ---------------------------------------------------------
# AES-256 key encrypting card numbers, CVVs, and account passwords.
#   openssl rand -base64 32
#
# In production this comes from Secret Manager and is NEVER committed, echoed in a
# build log, or pasted into a chat. Anyone holding it plus a database dump has every
# member's card and email password.
#
# Rotation: add VAULT_KEY_K2, point VAULT_KEY_ACTIVE at it, and leave K1 in place
# until the re-wrap job has migrated every row. Removing a key while rows still
# reference it makes those rows permanently unreadable.
VAULT_KEY_K1=""
VAULT_KEY_ACTIVE="k1"

# --- Bot ingest ------------------------------------------------------------
# openssl rand -base64 32 -- must match the bot's OKIE_INGEST_TOKEN
BOT_INGEST_TOKEN=""
# Set during a rotation so both tokens are accepted, then clear it.
BOT_INGEST_TOKEN_PREVIOUS=""
